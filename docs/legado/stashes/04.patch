+unit Conversa.Dispositivo;
+
+interface
+
+uses
+  System.JSON,
+  Conversa.Controller;
+
+type
+  TConversaDispositivoController = class(TConversaController)
+  public
+    procedure Registrar;
+  end;
+
+implementation
+
+uses
+  Conversa.Configuracoes,
+  Conversa.Dados,
+  Conversa.DeviceInfo.Utils,
+  Conversa.Proxy,
+  Conversa.Proxy.Tipos;
+
+{ TConversaDispositivoController }
+
+procedure TConversaDispositivoController.Registrar;
+var
+  Dispositivo: TDispositivo;
+begin
+  Dispositivo := Default(TDispositivo);
+  with GetDeviceInfo do
+  begin
+    Dispositivo.nome := DeviceName;
+    Dispositivo.plataforma := Model;
+    Dispositivo.versao_so := OSVersion;
+    Dispositivo.plataforma := Platform;
+    Dispositivo.usuario_id := Dados.FDadosApp.Usuario.ID;
+  end;
+  Configuracoes.DispositivoId := TConversaProxy.Create.Dispositivo.Registrar(Dispositivo);
+  Configuracoes.Save;
+end;
+
+end.
diff --git a/api/Conversa.Handler.pas b/api/Conversa.Handler.pas
new file mode 100644
index 0000000..454883b
