+unit Conversa.Proxy;
+
+interface
+
+uses
+  Conversa.REST,
+  Conversa.Proxy.Tipos;
+
+type
+  TDispositivoProxy = record
+    function Registrar(const ADispositivo: TDispositivo): Integer;
+  end;
+
+  TConversaProxy = class(TRESTAPI)
+  public
+    Dispositivo: TDispositivoProxy;
+    constructor Create;
+  end;
+
+implementation
+
+uses
+  System.JSON,
+  Conversa.Dados,
+  Conversa.Configuracoes;
+
+threadvar
+  Instance: TConversaProxy;
+
+{ TConversaProxy }
+
+constructor TConversaProxy.Create;
+begin
+  inherited;
+
+  Instance := Self;
+
+  if Assigned(Dados) and not Dados.FTokenJWT.IsEmpty then
+    Authorization(TAuthBearer.New(Dados.FTokenJWT));
+
+  Host(Configuracoes.Host);
+end;
+
+{ TDispositivo }
+
+function TDispositivoProxy.Registrar(const ADispositivo: TDispositivo): Integer;
+begin
+  with Instance do
+  try
+    Body(
+      TJSONObject.Create
+        .AddPair('nome', ADispositivo.nome)
+        .AddPair('modelo', ADispositivo.modelo)
+        .AddPair('versao_so', ADispositivo.versao_so)
+        .AddPair('plataforma', ADispositivo.Plataforma)
+        .AddPair('usuario_id', ADispositivo.usuario_id)
+    );
+    PUT;
+      Configuracoes.DispositivoId := Response.ToJSON.GetValue<Integer>('id');
+
+    Configuracoes.Save;
+  finally
+    Free;
+  end;
+end;
+
+end.
