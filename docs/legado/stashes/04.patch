+  public
+    constructor Create;
+    property Auth: TConversaAuth read FAuth;
+    property Dispositivo: TConversaDispositivoController read FDispositivo;
+  end;
+
+implementation
+
+{ TConversaAPI }
+
+constructor TConversaAPI.Create;
+begin
+  inherited;
+  FHandler := TConversaHandler.Create;
