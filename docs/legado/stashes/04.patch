diff --git a/api/Conversa.Auth.pas b/api/Conversa.Auth.pas
new file mode 100644
index 0000000..de71b49
--- /dev/null
+++ b/api/Conversa.Auth.pas
@@ -0,0 +1,51 @@
+unit Conversa.Auth;
+
+interface
+
+uses
+  System.JSON,
+  Conversa.Controller;
+
+type
+  TConversaAuth = class(TConversaController)
+  public
+    function Login(Usuario, Senha: String): Boolean;
+  end;
+
+implementation
+
+uses
+  Conversa.Configuracoes,
+  Conversa.Dados;
+
+{ TConversaAuth }
+
+function TConversaAuth.Login(Usuario, Senha: String): Boolean;
+begin
+  with Handler.POST(
+         'login',
+         TJSONObject.Create
+           .AddPair('login', Usuario)
+           .AddPair('senha', Senha)) do
+  try
+    if Response.Status = TResponseStatus.Sucess then
+    begin
+      with Response.ToJSON do
+        Dados.FDadosApp.Usuario :=
+          Dados.FDadosApp.Usuarios.GetOrAdd(GetValue<Integer>('id'))
+            .Nome(GetValue<String>('nome'))
+            .Email(GetValue<String>('email'))
+            .Telefone(GetValue<String>('telefone'));
+
+      Handler.TokenJWT := Response.ToJSON.GetValue<String>('token');
+      Result := True;
+    end;
+  finally
+    Free;
+  end;
+
+  if Configuracoes.DispositivoId = 0 then
+    Dados.API.Dispositivo.Registrar;
+end;
+
+end.
