+++ b/api/Conversa.Handler.pas
@@ -0,0 +1,59 @@
+unit Conversa.Handler;
+
+interface
+
+uses
+  System.SysUtils,
+  System.JSON,
+  System.Threading,
+  Conversa.REST;
+
+type
+  TResponseStatus = Conversa.REST.TResponseStatus;
+  TConversaHandler = class
+  private
+    FHost: String;
+    FTokenJWT: String;
+    function CreateRequest(Route: String): TRESTAPI;
+  public
+    property TokenJWT: String read FTokenJWT write FTokenJWT;
+    constructor Create;
+    function POST(Route: String; Body: TJSONObject): TRESTAPI;
+    function PUT(Route: string; Body: TJSONObject): TRESTAPI;
+  end;
+
+implementation
+
+{ TConversaHandler }
+
+constructor TConversaHandler.Create;
+begin
+  inherited;
+  FHost := 'http://localhost:90/';
+  TokenJWT := '';
+end;
+
+function TConversaHandler.CreateRequest(Route: String): TRESTAPI;
+begin
+  Result := TRESTAPI.Create;
+  Result.Host(FHost);
+  Result.Route(Route);
+end;
+
+function TConversaHandler.POST(Route: String; Body: TJSONObject): TRESTAPI;
+begin
+  Result :=
+    CreateRequest(Route)
+      .Body(Body)
+      .POST;
+end;
+
+function TConversaHandler.PUT(Route: string; Body: TJSONObject): TRESTAPI;
+begin
+  Result :=
+    CreateRequest(Route)
+      .Body(Body)
+      .PUT;
+end;
+
+end.
