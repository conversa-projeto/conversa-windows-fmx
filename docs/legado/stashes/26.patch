+procedure TFormularioBase.FormCreate(Sender: TObject);
+begin
+  rctClient.Align := TAlignLayout.Contents;
+  lytLeftResize.Visible := False;
+  lytTopResize.Visible := False;
+  lytRightResize.Visible := False;
+  lytBottomResize.Visible := False;
+  tmrResize.Enabled := True;
+  lytLeftResize.AutoCapture := True;
+  lytLeftTop.AutoCapture := True;
+  lytTopResize.AutoCapture := True;
+  lytRightTop.AutoCapture := True;
+  lytRightResize.AutoCapture := True;
+  lytRightBottom.AutoCapture := True;
+  lytBottomResize.AutoCapture := True;
+  lytLeftBottom.AutoCapture := True;
+  FResizeInfo.FResizing := False;
+end;
+
+procedure TFormularioBase.FormKeyDown(Sender: TObject; var Key: Word; var KeyChar: Char; Shift: TShiftState);
+begin
+  case Key of
+    vkEscape:
+    begin
+      if FDraging then
+      begin
+        FMaximized := not FMaximized;
+        DoConversaMaximize;
+        FDraging := False;
+      end;
+    end;
+  end;
+end;
+
+procedure TFormularioBase.FormMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Single);
+var
+  rfNot: TRect;
+begin
+  rfNot := GetBounds;
+  rfNot.SetLocation(0, 0);
