+procedure TFormularioBase.tmrResizeTimer(Sender: TObject);
+var
+  ptMouse: TPoint;
+  rctForm: TRect;
+  bVisible: Boolean;
+begin
+  bVisible := False;
+  try
+    if FMaximized then
+      Exit;
+    ptMouse := Screen.MousePos.Round;
+    rctForm := Self.GetBounds;
+    if not PtInRect(rctForm, ptMouse) then
+      Exit;
+
+    ptMouse := Self.ScreenToClient(ptMouse).Round;
+    rctForm.SetLocation(0, 0);
+    rctForm.Inflate(-5, -5);
+
+    if PtInRect(rctForm, ptMouse) then
+      Exit;
+
+    bVisible := True;
+  finally
+    lytLeftTop.Position.X := 0;
+    lytLeftTop.Position.Y := 0;
+
+    lytLeftBottom.Position.X := 0;
+    lytLeftBottom.Position.Y := -5;
+
+    lytRightTop.Position.X := lytTopResize.Width - 10;
+    lytRightTop.Position.Y := 0;
+
+    lytRightBottom.Position.X := lytTopResize.Width - 10;
+    lytRightBottom.Position.Y := -5;
+
+    lytLeftResize.Visible := bVisible;
+    lytTopResize.Visible := bVisible;
+    lytRightResize.Visible := bVisible;
+    lytBottomResize.Visible := bVisible;
+  end;
+end;
+
+procedure TFormularioBase.tmrResizingTimer(Sender: TObject);
+begin
+//  if FResizeInfo.FActualBounds.EqualsTo(FResizeInfo.FLastBounds) then
+//    Exit;
+
+  FResizeInfo.FLastBounds := FResizeInfo.FActualBounds;
+  Self.SetBoundsF(FResizeInfo.FLastBounds);
+end;
+
+procedure TFormularioBase.OnMouseDown_FormResize(Sender: TObject; Button: TMouseButton; Shift: TShiftState; X, Y: Single);
+begin
+  FResizeInfo.FResizing := True;
+  FResizeInfo.FMouseOffSet := PointF(X, Y);
+  FResizeInfo.FMouseDown := TLayout(Sender).LocalToScreen(FResizeInfo.FMouseOffSet);
+  FResizeInfo.FOriginalBounds := Self.GetBoundsF;
+  FResizeInfo.FGrable := Self.LayoutToGrab(TLayout(Sender));
+end;
+
+procedure TFormularioBase.OnMouseLeave_FormResize(Sender: TObject);
+begin
+  lytLeftResize.Visible := False;
+  lytTopResize.Visible := False;
+  lytRightResize.Visible := False;
+  lytBottomResize.Visible := False;
+end;
+
+procedure TFormularioBase.OnMouseMove_FormResize(Sender: TObject; Shift: TShiftState; X, Y: Single);
+var
+  ptOffSet: TPointF;
+  ptAtual: TPointF;
+  rAtual: TRectF;
+begin
+  if FResizeInfo.FResizing then
+  begin
+    {
+
+      PARA RESOLVER
+        - Ao atingir o topo da tela, buga o tamanho
+
+    }
+    tmrResizing.Enabled := True;
+    Self.BeginUpdate;
+    try
+      ptAtual := TLayout(Sender).LocalToScreen(PointF(X, Y));
+      ptOffSet := ptAtual;
+      ptOffSet.Offset(FResizeInfo.FMouseDown * -1);
+      ptAtual.Offset(ptOffSet);
+
+      FResizeInfo.FMouseDown := TLayout(Sender).LocalToScreen(PointF(X, Y));
+      FResizeInfo.FMouseDown.Offset(FResizeInfo.FMouseOffSet);
+      rAtual := Self.GetBoundsF;
+
+      if FResizeInfo.FGrable in [TGrabHandle.LeftTop, TGrabHandle.Left, TGrabHandle.LeftBottom] then
+        rAtual.Left := ptAtual.X;
+
+      if FResizeInfo.FGrable in [TGrabHandle.LeftTop, TGrabHandle.Top, TGrabHandle.RightTop] then
+        rAtual.Top := ptAtual.Y;
+
+      if FResizeInfo.FGrable in [TGrabHandle.RightTop, TGrabHandle.Right, TGrabHandle.RightBottom] then
+        rAtual.Right := ptAtual.X;
+
+      if FResizeInfo.FGrable in [TGrabHandle.LeftBottom, TGrabHandle.Bottom, TGrabHandle.RightBottom] then
+        rAtual.Bottom := ptAtual.Y;
+
+
+      if FResizeInfo.FGrable in [TGrabHandle.LeftTop, TGrabHandle.Left, TGrabHandle.LeftBottom] then
+        rAtual.Right := FResizeInfo.FOriginalBounds.Right;
+
+      if FResizeInfo.FGrable in [TGrabHandle.LeftTop, TGrabHandle.Top, TGrabHandle.RightTop] then
+        rAtual.Bottom := FResizeInfo.FOriginalBounds.Bottom;
+
+      if FResizeInfo.FGrable in [TGrabHandle.RightTop, TGrabHandle.Right, TGrabHandle.RightBottom] then
+        rAtual.Left := FResizeInfo.FOriginalBounds.Left;
+
+      if FResizeInfo.FGrable in [TGrabHandle.LeftBottom, TGrabHandle.Bottom, TGrabHandle.RightBottom] then
+        rAtual.Top := FResizeInfo.FOriginalBounds.Top;
+
+
+//      rAtual.Bottom := FOldBounds.Bottom;
+      FResizeInfo.FActualBounds := rAtual;
+    finally
+      Self.EndUpdate;
+    end;
+  end;
+end;
+
+procedure TFormularioBase.OnMouseUp_FormResize(Sender: TObject; Button: TMouseButton; Shift: TShiftState; X, Y: Single);
+begin
+  FResizeInfo.FResizing := False;
+  tmrResizing.Enabled := False;
+end;
+
+function TFormularioBase.LayoutToGrab(lyt: TLayout): TGrabHandle;
+var
+  I: Integer;
+begin
+  Result := TGrabHandle.None;
+  I := Succ(IndexStr(lyt.Name, ['lytLeftResize', 'lytLeftTop', 'lytTopResize', 'lytRightTop', 'lytRightResize', 'lytRightBottom', 'lytBottomResize', 'lytLeftBottom']));
+  if InRange(I, Integer(Low(TGrabHandle)), Integer(High(TGrabHandle))) then
+    Result := TGrabHandle(I);
+end;
+
+end.
