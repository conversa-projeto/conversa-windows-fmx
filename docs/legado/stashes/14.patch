   ExStyle := GetWindowLongPtr(hAppWnd, GWL_EXSTYLE);
   SetWindowLongPtr(hAppWnd, GWL_EXSTYLE, (ExStyle and not WS_EX_TOOLWINDOW) or WS_EX_APPWINDOW);
@@ -110,6 +114,8 @@ procedure TTelaInicial.FormActivate(Sender: TObject);
 begin
   inherited;
   ShowAppOnTaskbar;
