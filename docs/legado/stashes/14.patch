   Conversa.Configurar.Conexao,
-  Conversa.Notificacao;
+  Conversa.Notificacao,
+  Conversa.Chat.Listagem;
 
 {$R *.fmx}
 
@@ -87,7 +88,10 @@ var
   hAppWnd: HWND;
   ExStyle: LongInt;
 begin
-  hAppWnd := Fmx.Platform.Win.ApplicationHWND;
+  hAppWnd := FMX.Platform.Win.ApplicationHWND;
+  if IsWindowVisible(hAppWnd) then
+    Exit; // Se a janela já estiver visível, não faz nada
+
