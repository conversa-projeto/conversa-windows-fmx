+procedure TTelaInicial.btnTesteAudioClick(Sender: TObject);
+begin
+  if FTesteAudioAtivo then
+    PararTesteAudio
+  else
+    IniciarTesteAudio;
+end;
+
+procedure TTelaInicial.IniciarTesteAudio;
+begin
+  if FTesteAudioAtivo then
+    Exit;
+
+  FTesteAudioBuffer := TAudioBuffer.Create(1024 * 1024);
+  FTesteCapture := TAudioCaptureThread.Create(FTesteAudioBuffer);
+  FTestePlayer := TAudioPlayerThread.Create(FTesteAudioBuffer);
+
+  FTesteCapture.Start;
+  FTestePlayer.Start;
+
+  FTesteAudioAtivo := True;
+  btnTesteAudio.Text := 'Parar Teste';
+end;
+
+procedure TTelaInicial.PararTesteAudio;
+begin
+  if not FTesteAudioAtivo then
+    Exit;
+
+  if Assigned(FTesteCapture) then
+  begin
+    FTesteCapture.Finalizar;
+    FTesteCapture.WaitFor;
+    FreeAndNil(FTesteCapture);
+  end;
+
+  if Assigned(FTestePlayer) then
+  begin
+    FTestePlayer.Finalizar;
+    FTestePlayer.WaitFor;
+    FreeAndNil(FTestePlayer);
+  end;
+
+  FreeAndNil(FTesteAudioBuffer);
+
+  FTesteAudioAtivo := False;
+  btnTesteAudio.Text := 'Teste √Åudio';
+end;
+
 end.
