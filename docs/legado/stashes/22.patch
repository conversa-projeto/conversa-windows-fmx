@@ -0,0 +1,466 @@
+unit Conversa.Conexao;
+
+interface
+
+uses
+  System.Classes,
+  System.JSON,
+  System.SysUtils,
+  System.Threading,
+
+  IdGlobal,
+  IdTCPClient,
+  IdUDPClient,
+
+  Conversa.Configuracoes,
+  Tipos;
+
+type
+  TOrigemComando = (Desconhecida, Local, Remoto);
+  TConversaConexao = class
+  private
+    FTCP: TIdTCPClient;
+    FTCPWork: TThread;
+    FUDP: TIdUDPClient;
+
+    FLocalPonta: TPonta;
+    FRemetente: TPonta;
+
+    constructor Create;
+    procedure TCPWork;
+
+
+    procedure ReceberChamada;
+    procedure IniciarEnvioAudio;
+    procedure IniciaAudio;
+    procedure AbrirTela;
+    procedure EncerrarChamada;
+    procedure InicializarUDP;
+    procedure DestinatarioOcupado;
+  public
+//    OnAtenderChamada: TProc;
+//    OnRecusarChamada: TProc;
+//    OnReceberChamada: TProc;
+//    OnFinalizarChamada: TProc;
+//    OnCancelarChamada: TProc;
+//    OnDestinatarioOcupado: TProc;
+
+    destructor Destroy; override;
+    class function Instance: TConversaConexao;
+    procedure Finalize;
+    procedure Conectar;
+
+    procedure IniciarChamada(ID: Integer);
+    procedure AtenderChamada(Origem: TOrigemComando; bRetomando: Boolean);
+    procedure FinalizarChamada(Origem: TOrigemComando);
+    procedure RecusarChamada(Origem: TOrigemComando);
+    procedure CancelarChamada(Origem: TOrigemComando);
+
+    procedure TCPSendCommand(Method: TMethod; Bytes: TIdBytes);
+  end;
+
+implementation
+
+uses
+  Conversa.Dados,
+  Conversa.Chamada;
+
+var
+  FInstance: TConversaConexao;
+
+{ TConversaConexao }
+
+constructor TConversaConexao.Create;
+begin
+  FTCP := TIdTCPClient.Create(nil);
+  FUDP := TIdUDPClient.Create(nil);
+end;
+
+procedure TConversaConexao.DestinatarioOcupado;
+begin
+
+end;
+
+destructor TConversaConexao.Destroy;
+begin
+  FUDP.Disconnect;
+  FTCP.Disconnect;
+  //FTCPWork.WaitFor;
+  FreeAndNil(FUDP);
+  FreeAndNil(FTCP);
+  inherited;
+end;
+
+procedure TConversaConexao.EncerrarChamada;
+begin
+
+end;
+
+procedure TConversaConexao.FinalizarChamada(Origem: TOrigemComando);
+begin
+
+end;
+
+procedure TConversaConexao.Finalize;
+begin
+  FreeAndNil(FInstance);
+end;
+
+class function TConversaConexao.Instance: TConversaConexao;
+begin
+  if not Assigned(FInstance) then
+  begin
+    FInstance := TConversaConexao.Create;
+    FInstance.Conectar;
+  end;
+
+  Result := FInstance;
+end;
+
+procedure TConversaConexao.Conectar;
+var
+  sIdentificador: string;
+begin
+  FLocalPonta := Default(TPonta);
+  FRemetente  := Default(TPonta);
+  FLocalPonta.ID := Dados.ID;
+  with TJSONObject.Create do
+  try
+    AddPair('id', Dados.ID);
+    AddPair('nome', Dados.Nome);
+    AddPair('email', Dados.Email);
+    sIdentificador := ToJSON;
+  finally
+    Free;
+  end;
+  FUDP.Host := Configuracoes.Host;
+  FUDP.Port := Configuracoes.UdpPort;
+  FUDP.Active := False;
+  try
+    FTCP.Disconnect;
+    FTCP.Host := Configuracoes.Host;
+    FTCP.Port := Configuracoes.TcpPort;
+    FTCP.Disconnect;
+    FTCP.Connect;
+  except on E: Exception do
+    raise Exception.Create('Falha ao conectar!');
+  end;
+  try
+    TCPSendCommand(TMethod.Registrar, TSerializer<Integer>.ParaBytes(Dados.ID));
+  except on E: Exception do
+    raise Exception.Create('Falha ao registrar!'+ sLineBreak + E.Message);
+  end;
+  try
+    TCPSendCommand(TMethod.AtribuirIdentificador, TSerializer<String>.ParaBytes(sIdentificador));
+  except on E: Exception do
+    raise Exception.Create('Falha ao se identificar!'+ sLineBreak + E.Message);
+  end;
+  // Cria a tread de conexão
+  FTCPWork := TThread.CreateAnonymousThread(TCPWork);
+  FTCPWork.Start;
+//  AddLog('Conectar - F');
+//  AppEvents.Run(TConversaAppEventType.Conectado);
+end;
+
+procedure TConversaConexao.TCPSendCommand(Method: TMethod; Bytes: TIdBytes);
+var
+  Tamanho: Integer;
+begin
+  try
+    TMonitor.Enter(FTCP);
+    try
+//      AddLog(IndyTextEncoding_UTF8.GetString(Bytes));
+//      case Method of
+//        TMethod.Erro: AddLog('E - Erro');
+//        TMethod.Registrar: AddLog('E - Registrar');
+//        TMethod.IniciarChamada: AddLog('E - IniciarChamada');
+//        TMethod.CancelarChamada: AddLog('E - CancelarChamada');
+//        TMethod.ReceberChamada: AddLog('E - ReceberChamada');
+//        TMethod.AtenderChamada: AddLog('E - AtenderChamada');
+//        TMethod.AtribuirUDP: AddLog('E - AtribuirUDP');
+//        TMethod.RetomarChamada: AddLog('E - RetomarChamada');
+//        TMethod.RecusarChamada: AddLog('E - RecusarChamada');
+//        TMethod.FinalizarChamada: AddLog('E - FinalizarChamada');
+//        TMethod.ChamadasAtivas: AddLog('E - ChamadasAtivas');
+//        TMethod.FinalizarTodasChamadas: AddLog('E - FinalizarTodasChamadas');
+//      end;
+      Tamanho := Length(Bytes);
+//      AddLog('T: '+ Tamanho.ToString);
+//      AddLog('C: '+ BytesToString(Bytes));
+      FTCP.IOHandler.Write(Byte(Method));
+      FTCP.IOHandler.Write(Tamanho);
+      FTCP.IOHandler.Write(Bytes);
+//      AddLog('E.F.');
+    finally
+      TMonitor.Exit(FTCP);
+    end;
+  except on E: Exception do
+    begin
+//      AddLog('TCPSendCommand: '+ E.Message, True);
+      raise;
+    end;
+  end;
+end;
+
+procedure TConversaConexao.TCPWork;
+var
+  Tamanho: Integer;
+  Bytes: TIdBytes;
+  Method: TMethod;
+begin
+//  AddLog('LoopTCP - I');
+  while FTCP.Connected do
+  begin
+    try
+      TMonitor.Enter(FTCP);
+      try
+        // Verifica se desconectou
+//        AddLog('LoopTCP - CheckForDisconnect');
+        FTCP.IOHandler.CheckForDisconnect;
+        // Espera receber os dados
+//        AddLog('LoopTCP - CheckForDataOnSource');
+        FTCP.IOHandler.CheckForDataOnSource(10);
+        // Verifica se tem dados
+//        AddLog('LoopTCP - InputBufferIsEmpty');
+        if FTCP.IOHandler.InputBufferIsEmpty then
+          Continue;
+        Method := TMethod(FTCP.IOHandler.ReadByte);
+        Bytes := [];
+//        case Method of
+//          TMethod.Erro: AddLog('R - Erro');
+//          TMethod.Registrar: AddLog('R - Registrar');
+//          TMethod.IniciarChamada: AddLog('R - IniciarChamada');
+//          TMethod.CancelarChamada: AddLog('R - CancelarChamada');
+//          TMethod.ReceberChamada: AddLog('R - ReceberChamada');
+//          TMethod.AtenderChamada: AddLog('R - AtenderChamada');
+//          TMethod.RetomarChamada: AddLog('R - RetomarChamada');
+//          TMethod.RecusarChamada: AddLog('R - RecusarChamada');
+//          TMethod.FinalizarChamada: AddLog('R - FinalizarChamada');
+//          TMethod.ChamadasAtivas: AddLog('R - ChamadasAtivas');
+//          TMethod.FinalizarTodasChamadas: AddLog('R - FinalizarTodasChamadas');
+//        end;
+        Tamanho := FTCP.IOHandler.ReadInt32;
+//        AddLog('RT: '+ Tamanho.ToString);
+        if Tamanho > 0 then
+          FTCP.IOHandler.ReadBytes(Bytes, Tamanho)
+        else
+          Bytes := [];
+
+        if TConversaChamada.EventoChamada(Method) then
+        begin
+          TConversaChamada.Instance.ProcessarEvento(Method, Tamanho, Bytes);
+          Continue;
+        end;
+
