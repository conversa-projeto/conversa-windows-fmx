+unit Conversa.Chamada.BarraTitulo;
+
+interface
+
+uses
+  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants, 
+  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
+  Conversa.FrameBase, FMX.Objects, FMX.Layouts,
+
+  Conversa.Chamada,
+  Tipos;
+
+type
+  TChamadaBarraTitulo = class(TFrameBase)
+    rctFundo: TRectangle;
+    lytFinalizarChamada: TLayout;
+    pthFinalizarChamada: TPath;
+    txtTempoLigacao: TText;
+    lytAtenderChamada: TLayout;
+    pthAtenderChamada: TPath;
+    lytIconeChamada: TLayout;
+    pthIconeChamada_Realizada: TPath;
+    pthIconeChamada_Recebida: TPath;
+    pthIconeChamada_Recusada: TPath;
+    procedure lytAtenderChamadaClick(Sender: TObject);
+    procedure lytFinalizarChamadaClick(Sender: TObject);
+  private
+    { Private declarations }
+    FStatus: TMethod;
+  public
+    { Public declarations }
+    class function Instance: TChamadaBarraTitulo;
+    procedure Exibir;
+    function Status(Method: TMethod): TChamadaBarraTitulo;
+    procedure Ocultar;
+  end;
+
+var
+  ChamadaBarraTitulo: TChamadaBarraTitulo;
+
+implementation
+
+{$R *.fmx}
+
+uses
+  Conversa.Tela.Inicial.view;
+
+{ TChamadaBarraTitulo }
+
+procedure TChamadaBarraTitulo.Exibir;
+begin
+  Parent := TelaInicial.lytTitleBarClient;
+  Align := TAlignLayout.Center;
+  Visible := True;
+end;
+
+class function TChamadaBarraTitulo.Instance: TChamadaBarraTitulo;
+begin
+  if Assigned(ChamadaBarraTitulo) then
+    Exit(ChamadaBarraTitulo);
+
+  ChamadaBarraTitulo := TChamadaBarraTitulo.Create(TelaInicial.lytTitleBarClient);
+  Result := ChamadaBarraTitulo;
+end;
+
+procedure TChamadaBarraTitulo.lytAtenderChamadaClick(Sender: TObject);
+begin
+  inherited;
+  TConversaChamada.Instance.Atender;
+end;
+
+procedure TChamadaBarraTitulo.lytFinalizarChamadaClick(Sender: TObject);
+begin
+  inherited;
+  case FStatus of
+    TMethod.Erro: ;
+    TMethod.Registrar: ;
+    TMethod.AtribuirIdentificador: ;
+    TMethod.AtribuirUDP: ;
+    TMethod.IniciarChamada: TConversaChamada.Instance.Cancelar;
+    TMethod.CancelarChamada: ;
+    TMethod.DestinatarioOcupado: ;
+    TMethod.ReceberChamada: TConversaChamada.Instance.Recusar;
+    TMethod.AtenderChamada: ;
+    TMethod.RetomarChamada: ;
+    TMethod.RecusarChamada: ;
+    TMethod.FinalizarChamada: ;
+    TMethod.ChamadasAtivas: ;
+    TMethod.FinalizarTodasChamadas: ;
+    TMethod.UsuarioDesconectado: ;
+  end;
+end;
+
+procedure TChamadaBarraTitulo.Ocultar;
+begin
+  Self.Visible := False;
+end;
+
+function TChamadaBarraTitulo.Status(Method: TMethod): TChamadaBarraTitulo;
+begin
+  FStatus := Method;
+  pthIconeChamada_Realizada.Visible := Method in [TMethod.IniciarChamada];
+  pthIconeChamada_Recebida.Visible := Method in [TMethod.ReceberChamada];
+  pthIconeChamada_Recusada.Visible := Method in [TMethod.RecusarChamada];
+
+  case Method of
+    TMethod.Erro: ;
+    TMethod.Registrar: ;
+    TMethod.AtribuirIdentificador: ;
+    TMethod.AtribuirUDP: ;
+    TMethod.IniciarChamada:
+    begin
+      lytAtenderChamada.Visible := False;
+    end;
+    TMethod.CancelarChamada: ;
+    TMethod.DestinatarioOcupado: ;
+    TMethod.ReceberChamada:
+    begin
+      //
+    end;
+    TMethod.AtenderChamada:
+    begin
+      lytAtenderChamada.Visible := False;
+    end;
+    TMethod.RetomarChamada: ;
+    TMethod.RecusarChamada:
+    begin
+      lytAtenderChamada.Visible := False;
+      lytFinalizarChamada.Visible := False;
+    end;
+    TMethod.FinalizarChamada: ;
+    TMethod.ChamadasAtivas: ;
+    TMethod.FinalizarTodasChamadas: ;
+    TMethod.UsuarioDesconectado: ;
+  end;
+end;
+
+end.
diff --git a/src/chamada/Conversa.Chamada.pas b/src/chamada/Conversa.Chamada.pas
