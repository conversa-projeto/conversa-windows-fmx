+procedure TPlatformWin.SetWindowCaption(const AForm: TCommonCustomForm; const ACaption: string);
+begin
+  RaiseIfNil(AForm, 'AForm');
+
+  SetWindowText(FormToHWND(AForm), ACaption);
+end;
